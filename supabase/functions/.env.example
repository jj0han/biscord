# Edge function secrets (`supabase secrets set --env-file supabase/functions/.env` in production)
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-livekit-api-key
LIVEKIT_API_SECRET=your-livekit-api-secret
GIPHY_API_KEY=your-giphy-api-key
# Bot of the same Discord application (Bot tab); turn on the Server Members
# and Message Content intents there. Used by discord-import.
DISCORD_BOT_TOKEN=your-discord-bot-token
